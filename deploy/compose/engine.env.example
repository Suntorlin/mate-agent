# Environment for docker-compose.engine.yml: the control plane, the LLM
# gateway and the object store on one machine. Copy to .env.engine (ignored by
# git) and fill in. Every key the control plane reads is documented in
# .env.example; this file holds the ones this stack needs.

# --- Identity of the deployment ---------------------------------------------
DEPLOYMENT_NAME=agent-engine-local
APP_NAME=Mate Agent
GITHUB_BOT_USERNAME=agent-engine[bot]
SCM_PROVIDER=github
LOG_LEVEL=info
# Where sandboxes dial back to the control plane: a URL they can reach from
# the sandbox provider's network (a tunnel or public host, not localhost).
WORKER_URL=http://localhost:8797
# Kept for links the control plane builds; the product's origin.
WEB_APP_URL=http://localhost:3000

# --- Secrets the host refuses to boot without (openssl rand -base64 32) -----
TOKEN_ENCRYPTION_KEY=
PROVIDER_ACCOUNTS_ENCRYPTION_KEY=
REPO_SECRETS_ENCRYPTION_KEY=
BROWSER_AUTH_SECRET=

# --- Who may call it ----------------------------------------------------------
# The product's backend signs every request with this key and names the acting
# user as app:<id>; it is the only client this stack needs (openssl rand -hex 32).
SERVICE_AUTH_SECRET_APP=
# Nobody signs in here directly; the product relays its own users.
ALLOWED_EMAIL_DOMAINS=example.com

# --- Object store (the bundled SeaweedFS) -----------------------------------
OBJECT_STORE_ROOT_USER=objectstoreadmin
# openssl rand -hex 16
OBJECT_STORE_ROOT_PASSWORD=
OBJECT_STORE_BUCKET=media
# The object store as browsers and sandboxes reach it, when uploads and
# downloads go to it directly; empty proxies them through the control plane.
OBJECT_STORE_PUBLIC_ENDPOINT=
OBJECT_STORE_CORS_ORIGINS=

# --- LLM gateway ------------------------------------------------------------
# Shared by the control plane (signs each session's token) and the gateway
# (verifies it; compose hands it over as GATEWAY_SECRET). openssl rand -hex 32
GATEWAY_SECRET=
# The gateway as sandboxes reach it: a tunnel or public host in front of
# ENGINE_GATEWAY_PORT.
GATEWAY_URL=http://localhost:8795
# The upstream key. Prefer exporting it in the shell over writing it here.
OPENROUTER_API_KEY=
LLM_BUDGET_USD=25
LLM_USER_BUDGET_USD=20
LLM_USER_BUDGET_PERIOD=month
# 1 renews a session's 5-minute prompt cache while it is silent, so the next model call does not
# write the whole conversation again: one ping every 4.5 minutes, 13 while a tool runs (an hour)
# and 3 after a turn ended (about 19 minutes) unless the two counts below say otherwise.
CACHE_KEEPALIVE=
CACHE_KEEPALIVE_TOOL_PINGS=
CACHE_KEEPALIVE_IDLE_PINGS=

# Jev picks the thinking effort of prompts that ask for "auto".
# Pass the OpenRouter key from the shell (docker-compose.engine.yml reads $JEV_API_KEY),
# not this file. Unset: such prompts run at the session's effort.
# Service-wide monthly LLM budget in USD (empty: none; an admin can set it through
# the gateway's /llm/admin/settings), and the Lark custom-bot webhook its 80%/100%
# alerts go to.
LLM_MONTHLY_BUDGET_USD=
LLM_ALERT_WEBHOOK_URL=

# Each settled LLM call of a product's user (an app:<id> session) is POSTed
# here, with this bearer, for the product to bill; both or neither. The body:
# request_id, user_id (the product's id), session_id, model, usd_cost, the four
# token counts and occurred_at. The product must be idempotent on request_id.
LLM_USAGE_REPORT_URL=
LLM_USAGE_REPORT_TOKEN=

# --- The product ------------------------------------------------------------
# Its MCP server, and where the engine asks it for an app:<id> user's
# short-lived MCP token, with the engine's bearer there. All three set, both
# runtimes get the product's tools.
APP_MCP_URL=
APP_TOKEN_URL=
APP_ENGINE_TOKEN=
# The name the agent knows that MCP server by (its tools are
# mcp__<name>__<tool>); empty means "app".
APP_MCP_NAME=

# --- Sandboxes --------------------------------------------------------------
# The provider that runs sessions and its credentials (see .env.example for
# every provider's keys). Without valid credentials the stack boots and serves
# reads, but a session's sandbox fails to start.
SANDBOX_PROVIDER=vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_BASE_SNAPSHOT_ID=

# --- Published ports (loopback) ---------------------------------------------
ENGINE_APP_PORT=8797
ENGINE_GATEWAY_PORT=8795
ENGINE_OBJECT_STORE_PORT=9007
