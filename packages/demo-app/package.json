{
  "name": "@open-inspect/demo-app",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A reference product on the engine: accounts, credits, its own MCP tools, chat and preview",
  "scripts": {
    "build": "vite build",
    "start": "vite build && node server/main.ts",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@open-inspect/shared": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
