{
  // The core and Worker tests run inside workerd through @cloudflare/vitest-pool-workers: workers
  // types plus the `cloudflare:test` module, still without Node globals. test/node has its own.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "*.ts",
    "core/**/*.ts",
    "worker/**/*.ts",
    "../src/core/**/*.ts",
    "../src/worker/**/*.ts"
  ]
}
