  "GET /sessions/:id/children/:childId same-team-viewer=200",
  "POST /sessions/:id/children/:childId/cancel same-team-viewer=403",
  "POST /sessions/:id/slack-notify same-team-viewer=403",
  "POST /sessions/:id/inputs same-team-viewer=403",
  "GET /sessions/:id/inputs same-team-viewer=200",
]
`;

exports[`route admission sentinel > reports action denials for a same-team Viewer and admits a private collaborator 2`] = `
[
  "collaborator-on-private=200",
]
`;
