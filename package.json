{
  "name": "open-inspect",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sandbox:images": "python3 packages/sandbox-images/cli.py",
    "lint": "eslint .",
    "lint:complexity": "node scripts/lint-complexity.mjs",
    "lint:sql-portability": "node scripts/lint-sql-portability.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:lint-complexity": "node --test scripts/lint-complexity-message.test.mjs",
    "test:lint-sandbox-boundaries": "node --test scripts/lint-sandbox-boundaries.test.mjs",
    "test:lint-sql-portability": "node --test scripts/lint-sql-portability.test.mjs",
    "test:rbac-bootstrap-owner": "node --experimental-transform-types --test scripts/bootstrap-workspace-owner.test.ts",
    "test:user-merge-cli": "node --experimental-transform-types --test scripts/merge-split-users.test.ts",
    "test:cf-logs-cli": "node --test scripts/cf-logs.test.ts",
    "test:node-version-workflow-contract": "node --test scripts/node-version-workflow-contract.test.mjs",
    "test:harness": "node --test scripts/check-layout.test.mjs scripts/check-version.test.mjs scripts/check-migrations.test.mjs scripts/git-hooks/git-hooks.test.mjs scripts/agent-guard/agent-guard.test.mjs scripts/verify.test.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:public-safety": "node scripts/check-public-safety.ts --tree",
    "check:version": "node scripts/check-version.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "verify": "node scripts/verify.mjs",
    "e2e:local": "node scripts/local/e2e-demo.mjs",
    "e2e:ui": "node scripts/local/e2e-ui.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "typecheck": "npm run build -w @open-inspect/shared && npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "build": "npm run build -w @open-inspect/shared && npm run build --workspaces --if-present",
    "build:opencomputer-template": "npm run build-template -w @open-inspect/opencomputer-infra --",
    "rbac:bootstrap-owner": "node --experimental-transform-types scripts/bootstrap-workspace-owner.ts",
    "prepare": "node -e \"if (process.env.CI) process.exit(0)\" && husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "knip": "^6.32.1",
    "lint-staged": "^16.2.7",
    "playwright-core": "1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.21.0",
    "wrangler": "^4.103.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "proseWrap": "always"
        }
      }
    ]
  },
  "overrides": {
    "minimatch": "^10.2.5",
    "undici": "^7.29.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yaml,yml,css}": [
      "prettier --write"
    ],
    "packages/{daytona-infra,e2b-infra,modal-infra,sandbox-runtime,sandbox-images}/**/*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
